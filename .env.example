# Coloque aqui as variáveis de ambiente necessárias para rodar sua solução.
# Copie este arquivo para .env e preencha os valores.

DATABASE_URL=sqlite:////app/db/app.db
STORAGE_DIR=/app/storage
DATA_DIR=/app/data
DEMO_SEED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
ENGINE_MODE=full
ENGINE_RISK_MODEL_VERSION=risco_v1
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=20971520

# Railway (substitua os três caminhos acima no serviço de produção):
# DATABASE_URL=sqlite:////app/persist/app.db
# STORAGE_DIR=/app/persist/storage
# DATA_DIR=/app/data
